#!/usr/bin/env python3
"""Thin launcher for the agent-sandbox MCP server (stdio transport).

Runs the server from a source checkout without requiring an install by adding
``../src`` to ``sys.path`` before importing the package.
"""

from __future__ import annotations

import os
import sys

_SRC = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src")
if os.path.isdir(_SRC):
    sys.path.insert(0, os.path.abspath(_SRC))

from agent_sandbox_mcp.server import main  # noqa: E402

if __name__ == "__main__":
    main()
